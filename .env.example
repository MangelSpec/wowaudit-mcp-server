# WoWAudit team API key from https://wowaudit.com/api
WOWAUDIT_API_KEY=

# Integrators may instead inherit an exact-byte UTF-8 key on a dedicated FD.
# Set only one key source. The standard integrator descriptor is FD 3.
# WOWAUDIT_API_KEY_FD=3

# Production API origin. The default is recommended.
# WOWAUDIT_BASE_URL=https://api.wowaudit.com

# Per-request timeout in milliseconds (default: 30000, range: 5000-120000).
# WOWAUDIT_REQUEST_TIMEOUT_MS=30000

# Maximum accepted upstream JSON response size in bytes
# (default: 2097152, range: 65536-10485760).
# WOWAUDIT_MAX_RESPONSE_BYTES=2097152

# Write tools are hidden and blocked unless this is true.
# Leave unset for a strictly read-only server. Deletes also require confirm=true.
# WOWAUDIT_ENABLE_WRITES=false

# Restrict enabled writes to RaidLens character/raid create and update operations
# plus wishlist upload. Unknown non-empty values prevent server startup.
# WOWAUDIT_WRITE_POLICY=raidlens-create-update-v1

# Application tools expose sensitive applicant answers, identities, and files.
# Keep disabled unless the MCP client enforces an officer-only context.
# WOWAUDIT_ENABLE_APPLICATIONS=false
